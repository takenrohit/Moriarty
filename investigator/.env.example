# Environment variables read by the investigator (see src/main/resources/application.yml).
# Copy this file to .env and fill in real values. .env is git-ignored; never commit a real key.
#
# The defaults below suit running the investigator on the host against the Compose stack's
# published ports. In the Compose stack (deploy/docker-compose.yml) the backend URLs, the
# datasource and the Redis URL are set by compose to in-stack service names and override
# the values in this file.

# OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM endpoint. Required unless investigator.llm.enabled=false.
# Never commit or log the real value.
LLM_API_KEY=replace-with-your-api-key

# Model name sent to the LLM endpoint.
LLM_MODEL=gpt-4o-mini

# Request JSON object responses from the LLM (true or false).
LLM_JSON_MODE=true

# Retries per LLM request on 429/5xx errors (default 2). Raise to about 10 for rate-limited free tiers.
LLM_MAX_RETRIES=2

# IANA zone ID used to display times in reports.
INVESTIGATOR_DISPLAY_TIMEZONE=Asia/Kolkata

# Spring profiles. "mock" uses the built-in demo scenario. "real" selects the real
# integration clients whose endpoint below is set; "postgres" and "redis" enable
# persistence and the dedup lock. The Compose stack uses real,postgres,redis.
SPRING_PROFILES_ACTIVE=mock

# --- Observability backends (used only with the "real" profile) -----------------------
# An integration whose URL is blank falls back to the mock client.

# Prometheus HTTP API base URL (metrics).
PROMETHEUS_URL=http://localhost:9090
# Optional Prometheus credential: a bearer token, or a basic-auth user and password (not both).
# Not needed for the Compose stack. Never commit or log real values.
# PROMETHEUS_BEARER_TOKEN=
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=
# Per-request timeouts (Spring duration format).
# PROMETHEUS_CONNECT_TIMEOUT=2s
# PROMETHEUS_READ_TIMEOUT=10s

# Loki HTTP API base URL (logs).
LOKI_URL=http://localhost:3100

# Tempo HTTP API base URL (traces).
TEMPO_URL=http://localhost:3200

# --- Deployment history (GitHub Deployments API) ---------------------------------------
# Default: the Fake GitHub (WireMock) from the Compose stack, published on host port 8089.
# For real GitHub use https://api.github.com, your owner/repo and a fine-grained read-only token.
GITHUB_API_URL=http://localhost:8089
GITHUB_REPOSITORY=moriarty-demo/checkout-platform
# Not needed for the Fake GitHub. Never commit or log the real value.
# GITHUB_TOKEN=

# --- Persistence (used only with the "postgres" profile) -------------------------------
# Setting SPRING_DATASOURCE_URL also enables PostgreSQL persistence, so it is commented out.
# The password matches the Compose stack's local-only default (POSTGRES_PASSWORD).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/investigator
# SPRING_DATASOURCE_USERNAME=investigator
# SPRING_DATASOURCE_PASSWORD=investigator-local

# --- Deduplication lock (used only with the "redis" profile) ---------------------------
# REDIS_URL=redis://localhost:6379

# --- Webhook authentication ------------------------------------------------------------
# Shared secret that Alertmanager and Grafana must send as "Authorization: Bearer <secret>"
# or "X-Webhook-Token". Unset means alert endpoints accept unauthenticated requests.
# Never commit or log the real value.
# WEBHOOK_SECRET=

# --- Slack report publishing -----------------------------------------------------------
# Unset means reports are only logged and shown in the web UI. Never commit or log real values.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_CHANNEL_ID=

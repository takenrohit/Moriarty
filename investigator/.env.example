# Environment variables read by the investigator (see src/main/resources/application.yml).
# Copy this file to .env and fill in real values. .env is git-ignored; never commit a real key.
#
# The defaults below suit running the investigator on the host against the Compose stack's
# published ports. In the Compose stack (deploy/docker-compose.yml) the backend URLs, the
# datasource and the Redis URL are set by compose to in-stack service names and override
# the values in this file.

# OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM endpoint. Required unless investigator.llm.enabled=false.
# Never commit or log the real value.
LLM_API_KEY=replace-with-your-api-key

# Model name sent to the LLM endpoint.
LLM_MODEL=gpt-4o-mini

# Request JSON object responses from the LLM (true or false).
LLM_JSON_MODE=true

# Retries per LLM request on 429/5xx errors (default 2). Raise to about 10 for rate-limited free tiers.
LLM_MAX_RETRIES=2

# IANA zone ID used to display times in reports.
INVESTIGATOR_DISPLAY_TIMEZONE=Asia/Kolkata

# Spring profiles. "mock" uses the built-in demo scenario. "real" selects the real
# integration clients whose endpoint below is set; "postgres" and "redis" enable
# persistence and the dedup lock. The Compose stack uses real,postgres,redis.
SPRING_PROFILES_ACTIVE=mock

# --- Observability backends (used only with the "real" profile) -----------------------
# An integration whose URL is blank falls back to the mock client.

# Prometheus HTTP API base URL (metrics).
PROMETHEUS_URL=http://localhost:9090
# Optional Prometheus credential: a bearer token, or a basic-auth user and password (not both).
# Not needed for the Compose stack. Never commit or log real values.
# PROMETHEUS_BEARER_TOKEN=
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=
# Per-request timeouts (Spring duration format).
# PROMETHEUS_CONNECT_TIMEOUT=2s
# PROMETHEUS_READ_TIMEOUT=10s

# Loki HTTP API base URL (logs).
LOKI_URL=http://localhost:3100
# Optional Loki credential: a bearer token, or a basic-auth user and password (not both).
# Not needed for the Compose stack. Never commit or log real values.
# LOKI_BEARER_TOKEN=
# LOKI_USERNAME=
# LOKI_PASSWORD=
# Per-request timeouts (Spring duration format).
# LOKI_CONNECT_TIMEOUT=2s
# LOKI_READ_TIMEOUT=10s
# Stream label holding the service name (logs sent over OTLP are labelled service_name).
# LOKI_SERVICE_LABEL=service_name

# Tempo HTTP API base URL (traces).
TEMPO_URL=http://localhost:3200
# Optional Tempo credential: a bearer token, or a basic-auth user and password (not both).
# Not needed for the Compose stack. Never commit or log real values.
# TEMPO_BEARER_TOKEN=
# TEMPO_USERNAME=
# TEMPO_PASSWORD=
# Per-request timeouts (Spring duration format).
# TEMPO_CONNECT_TIMEOUT=2s
# TEMPO_READ_TIMEOUT=10s

# OTLP/HTTP endpoint for the investigator's own spans (investigation, tool.*, llm.chat).
# Used only with the "real" profile; default http://otel-collector:4318/v1/traces (the Compose
# collector). Without the "real" profile spans stay in memory and are not exported.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Deployment history (GitHub Deployments API) ---------------------------------------
# Default: the Fake GitHub (WireMock) from the Compose stack, published on host port 8089.
# For real GitHub use https://api.github.com, your owner/repo and a fine-grained read-only token.
GITHUB_API_URL=http://localhost:8089
GITHUB_REPOSITORY=moriarty-demo/checkout-platform
# Deployments must carry payload.service and payload.version (the deploy scripts set them).
# Bearer token, sent as "Authorization: Bearer <token>". Not needed for the Fake GitHub.
# Never commit or log the real value.
# GITHUB_TOKEN=
# Per-request timeouts (Spring duration format).
# GITHUB_CONNECT_TIMEOUT=2s
# GITHUB_READ_TIMEOUT=10s

# --- Persistence (used only with the "postgres" profile) -------------------------------
# Without the "postgres" profile the in-memory repositories are used and these are ignored.
# Flyway migrates as the schema owner; the application connects as a separate non-owner role
# that the migrations create with the datasource password and that cannot UPDATE or DELETE audit
# rows. The values below are the Compose stack's local-only defaults (also the built-in defaults
# of application-postgres.yml); use your own outside a local run and never commit real ones.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/investigator
# SPRING_DATASOURCE_USERNAME=investigator_app
# SPRING_DATASOURCE_PASSWORD=investigator-app-local
# SPRING_FLYWAY_USER=investigator
# SPRING_FLYWAY_PASSWORD=investigator-local

# --- Deduplication lock (used only with the "redis" profile) ---------------------------
# REDIS_URL=redis://localhost:6379

# --- Webhook authentication ------------------------------------------------------------
# Shared secret that Alertmanager and Grafana must send as "Authorization: Bearer <secret>"
# or "X-Webhook-Token". Unset means alert endpoints accept unauthenticated requests.
# Never commit or log the real value. To make the Compose Alertmanager send it, see
# deploy/alertmanager/alertmanager.yml.
# WEBHOOK_SECRET=
# Alert label holding the affected service in Alertmanager and Grafana webhooks (default service).
# WEBHOOK_SERVICE_LABEL=service

# --- Slack report publishing -----------------------------------------------------------
# Reports are posted to Slack only when both SLACK_BOT_TOKEN and SLACK_CHANNEL_ID are set;
# setting one without the other fails startup. Unset means reports are only logged and shown
# in the web UI. Never commit or log real values.
# Bot token (xoxb-...) of a Slack app with the chat:write scope, invited to the channel.
# SLACK_BOT_TOKEN=
# Signing secret of the Slack app (reserved for Slack interactions; not needed to post).
# SLACK_SIGNING_SECRET=
# Channel ID to post to, for example C0123456789.
# SLACK_CHANNEL_ID=
# Slack Web API base URL (default https://slack.com/api).
# SLACK_API_URL=https://slack.com/api

# Public base URL of this investigator, used for the "View report" link in Slack messages.
INVESTIGATOR_PUBLIC_URL=http://localhost:8080

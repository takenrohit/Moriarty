{
  "name": "GET deployments: baseline checkout-api v2.14.2 deployed 26 h ago",
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPath": "/repos/moriarty-demo/checkout-platform/deployments"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-GitHub-Api-Version": "2022-11-28",
      "X-RateLimit-Limit": "5000",
      "X-RateLimit-Remaining": "4999",
      "X-RateLimit-Reset": "{{now offset='1 hours' format='unix'}}"
    },
    "bodyFileName": "deployments.json",
    "transformers": ["response-template"]
  }
}

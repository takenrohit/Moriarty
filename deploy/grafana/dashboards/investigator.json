{
  "uid": "investigator",
  "title": "Investigator",
  "description": "The investigator's own metrics (architecture section 8, CP-70, CP-71). Traces: Explore > Tempo, service.name=investigator.",
  "tags": ["investigator"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Investigation funnel: finished investigations by status (per minute)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(investigator_investigation_duration_seconds_count[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Investigation duration p50 / p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(investigator_investigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(investigator_investigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tool calls by tool and status (per minute)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tool, status) (rate(investigator_tool_calls_total[5m])) * 60",
          "legendFormat": "{{tool}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tool latency p95 by tool",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(investigator_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM tokens by direction and model (per minute)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (direction, model) (rate(investigator_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{direction}} {{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Reports by validation status (per hour)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (validation_status) (increase(investigator_report_generated_total[1h]))",
          "legendFormat": "{{validation_status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "LLM failure rate (fallback reports, failed investigations, 1h)",
      "description": "Share of stored reports that are the evidence-only fallback, and share of investigations ending FAILED.",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(investigator_report_generated_total{validation_status=\"fallback\"}[1h])) / clamp_min(sum(increase(investigator_report_generated_total[1h])), 1)",
          "legendFormat": "fallback reports"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(investigator_investigation_duration_seconds_count{status=\"FAILED\"}[1h])) / clamp_min(sum(increase(investigator_investigation_duration_seconds_count[1h])), 1)",
          "legendFormat": "failed investigations"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Evidence coverage (reports with validated citations, 1h)",
      "description": "Share of stored reports built from a draft whose citations all passed validation (valid or corrected), as opposed to the fallback.",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(investigator_report_generated_total{validation_status=~\"valid|corrected\"}[1h])) / clamp_min(sum(increase(investigator_report_generated_total[1h])), 1)",
          "legendFormat": "validated citations"
        }
      ]
    }
  ]
}
